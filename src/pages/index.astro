---
import Layout from '../components/Layout.astro';
import { isSupportedLocale, DEFAULT_LOCALE, type Locale } from '../lib/i18n-locales.ts';
import { tSync } from '../lib/translate.ts';

const cookieLocale = Astro.cookies.get('english.uiLocale')?.value;
const locale: Locale = (isSupportedLocale(cookieLocale) ? cookieLocale : DEFAULT_LOCALE) as Locale;

const title = tSync('ui.landing.title', locale);
const description = tSync('ui.landing.description', locale);
const startLabel = tSync('ui.start', locale);
const howTitle = tSync('ui.landing.how_title', locale);
const howStep1 = tSync('ui.landing.how_step1', locale);
const howStep2 = tSync('ui.landing.how_step2', locale);
const howStep3 = tSync('ui.landing.how_step3', locale);
---
<Layout title={title} description={description}>
  <section class="flex flex-col items-start gap-6 py-10">
    <h1 class="font-display text-4xl font-bold text-primary">{title}</h1>
    <p class="max-w-prose text-lg text-slate-700 dark:text-slate-200">{description}</p>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <a
        href="/lessons"
        class="inline-flex items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-base font-semibold text-white shadow-sm transition hover:bg-primary-700"
      >
        {startLabel}
      </a>
      <a
        href="/vocabulary"
        class="inline-flex items-center justify-center rounded-lg border border-primary-300 bg-white px-5 py-2.5 text-base font-semibold text-primary-700 transition hover:border-primary-400 hover:bg-primary-50 dark:border-primary-700 dark:bg-slate-800 dark:text-primary-200 dark:hover:bg-primary-800/30"
      >
        Top 2000 words
      </a>
    </div>
  </section>

  <section class="flex flex-col gap-4 border-t border-slate-200 py-10 dark:border-slate-700">
    <h2 class="font-display text-2xl font-semibold text-slate-900 dark:text-slate-100">{howTitle}</h2>
    <ol class="grid gap-4 sm:grid-cols-3">
      <li class="rounded-2xl border border-primary-100 bg-white p-5 dark:border-primary-800 dark:bg-slate-800">
        <span class="mb-2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">1</span>
        <p class="text-sm font-medium text-slate-700 dark:text-slate-200">{howStep1}</p>
      </li>
      <li class="rounded-2xl border border-primary-100 bg-white p-5 dark:border-primary-800 dark:bg-slate-800">
        <span class="mb-2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">2</span>
        <p class="text-sm font-medium text-slate-700 dark:text-slate-200">{howStep2}</p>
      </li>
      <li class="rounded-2xl border border-primary-100 bg-white p-5 dark:border-primary-800 dark:bg-slate-800">
        <span class="mb-2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">3</span>
        <p class="text-sm font-medium text-slate-700 dark:text-slate-200">{howStep3}</p>
      </li>
    </ol>
  </section>
</Layout>
