---
import Layout from '../../components/Layout.astro';
import VocabularyApp from '../../components/vocabulary/VocabularyApp.tsx';
import VocabularyChunkCard from '../../components/VocabularyChunkCard.astro';
import CardProgress from '../../components/CardProgress.astro';
import {isSupportedLocale,DEFAULT_LOCALE} from '../../lib/i18n-locales.ts';
import {listLessons,type LessonListItem} from '../../lib/lessons-service.ts';
import {classVocabularyEntries} from '../../content/class-notes/vocabulary.ts';
import {vocabularyFamily} from '../../lib/lesson-kind.ts';
import {tMany} from '../../lib/translate.ts';
import {srsEnglish,type SrsLabels} from '../../content/translations/vocabulary-srs.ts';
import {vocabularyText} from '../../lib/page-labels.ts';
const cookie=Astro.cookies.get('english.uiLocale')?.value;
const locale=isSupportedLocale(cookie)?cookie:DEFAULT_LOCALE;
const map=await tMany(Object.keys(srsEnglish).map(k=>'vocabulary.srs.'+k),locale==='es'?'es':'en');
const labels=Object.fromEntries(Object.keys(srsEnglish).map(k=>[k,map.get('vocabulary.srs.'+k)])) as SrsLabels;
let classroom:LessonListItem[]=[];
try{classroom=(await listLessons(locale,{category:'vocabulary'})).filter(l=>vocabularyFamily(l.slug)==='class');}catch{/* Flashcards do not require the lesson database. */}
---
<Layout title={labels.title} description={labels.subtitle}>
 <VocabularyApp client:load labels={labels} locale={locale}/>
 {classroom.length>0&&<section aria-labelledby="class-vocabulary-title" class="mt-12 space-y-4 border-t border-slate-300 pt-8 dark:border-slate-600">
  <h2 id="class-vocabulary-title" class="text-2xl font-bold">{vocabularyText(locale,'classVocabulary')}</h2>
  <p>{vocabularyText(locale,'classVocabularyHelp')}</p>
  <ul class="grid items-start gap-4 sm:grid-cols-2">{classroom.map(l=><li><VocabularyChunkCard slug={l.slug} title={l.title} locale={locale} preview={(classVocabularyEntries(l.slug)??[]).slice(0,8).map(e=>e.word)}><CardProgress slug={l.slug} total={l.count} locale={locale}/></VocabularyChunkCard></li>)}</ul>
 </section>}
</Layout>
