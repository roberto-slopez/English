---
import Layout from '../../components/Layout.astro';
import ExerciseRunner from '../../components/ExerciseRunner.tsx';
import ContentError from '../../components/ContentError.astro';
import {isSupportedLocale,DEFAULT_LOCALE} from '../../lib/i18n-locales.ts';
import {getLessonBySlug,getNextVocabularyLesson} from '../../lib/lessons-service.ts';
import {tMany} from '../../lib/translate.ts';
import {vocabLessons} from '../../content/vocabulary/top2000-vocabulary.ts';
import {uiText} from '../../lib/ui-labels.ts';
import {marked} from 'marked';
const {slug}=Astro.params;
const cookie=Astro.cookies.get('english.uiLocale')?.value;
const locale=isSupportedLocale(cookie)?cookie:DEFAULT_LOCALE;
const native=Astro.cookies.get('english.nativeLocale')?.value;
const nativeLocale=isSupportedLocale(native)?native:null;
const isVocab=slug?.startsWith('vocab-chunk-')??false;
let lesson:Awaited<ReturnType<typeof getLessonBySlug>>=null;let error=false;let nextLessonSlug:string|null=null;
try{lesson=slug?await getLessonBySlug(slug,locale):null;
 if(lesson&&isVocab){
   nextLessonSlug=(await getNextVocabularyLesson(lesson.slug,locale))?.slug??null;
   const source=vocabLessons.find(l=>l.slug===slug);
   if(source){const old=lesson.exercises;lesson.exercises=source.exercises.slice().sort((a,b)=>a.orderIndex-b.orderIndex).map(e=>({...e,id:old.find(o=>o.promptKey===e.promptKey)?.id??-e.orderIndex}));
     const keys=lesson.exercises.flatMap(e=>[e.promptKey,e.explanationKey,e.proTipKey].filter((v):v is string=>!!v));
     const values=await tMany(keys,locale);lesson.translations={...lesson.translations,...Object.fromEntries(values)};
   }
 }
}catch{error=true;Astro.response.status=503;}
if(!error&&!lesson)Astro.response.status=404;
const title=lesson?.title??uiText(locale,'lessons');
const intro=lesson?.intro?marked.parse(lesson.intro,{async:false}) as string:'';
const englishPrompts=lesson?Object.fromEntries(await tMany(lesson.exercises.map(e=>e.promptKey),'en')):{};
---
<Layout title={title} description={lesson?.description??''}>
 {error?<ContentError locale={locale}/>:lesson?<ExerciseRunner client:load lessonSlug={lesson.slug} lessonTitle={lesson.title} lessonIntro={intro} exercises={lesson.exercises} translations={lesson.translations} englishPrompts={englishPrompts} nativeLocale={nativeLocale} uiLocale={locale} nextLessonSlug={nextLessonSlug} lessonKind={isVocab?'vocab':'lesson'}/>:<p>{uiText(locale,'noResults')}</p>}
 <div class="mt-8 text-center"><a href={isVocab?'/vocabulary':'/lessons'} class="touch-target inline-flex text-link underline">← {uiText(locale,isVocab?'backVocabulary':'backLessons')}</a></div>
</Layout>

