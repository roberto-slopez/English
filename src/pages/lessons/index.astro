---
import Layout from '../../components/Layout.astro';
import LessonCardProgress from '../../components/LessonCardProgress.tsx';
import { isSupportedLocale, DEFAULT_LOCALE, type Locale } from '../../lib/i18n-locales.ts';
import { listLessons } from '../../lib/lessons-repo.ts';
import { tSync } from '../../lib/translate.ts';

const cookieLocale = Astro.cookies.get('english.uiLocale')?.value;
const locale: Locale = (isSupportedLocale(cookieLocale) ? cookieLocale : DEFAULT_LOCALE) as Locale;

const title = tSync('ui.lessons.title', locale);
const intro = tSync('ui.lessons.intro', locale);
const lessons = listLessons(locale);

// Bucket every lesson into a small set of high-level categories. Each
// category is defined by a stable `key` (used for IDs / i18n), an
// i18n-resolved label, and a predicate that returns true when a lesson
// belongs to it. Order is significant — that's the order in the UI.
//
// NOTE: vocabulary chunks (`vocab-chunk-*`) are intentionally NOT
// bucketed here — they live in their own section at /vocabulary so the
// learner can drill the top-2000 word list without it being mixed in
// with grammar / idioms.
interface Category {
  key: string;
  label: string;
  match: (slug: string) => boolean;
}

const categories: Category[] = [
  {
    key: 'grammar',
    label: tSync('ui.category.grammar', locale),
    match: (slug) =>
      [
        'because-so-that',
        'adverbs-of-frequency',
        'time-expressions',
        'did-and-was',
        'simple-past-and-past-continuous',
      ].includes(slug),
  },
  {
    key: 'wh_words',
    label: tSync('ui.category.wh_words', locale),
    match: (slug) => slug.startsWith('wh-words-'),
  },
  {
    key: 'idioms',
    label: tSync('ui.category.idioms', locale),
    match: (slug) => slug === 'top-1000-idioms',
  },
  {
    key: 'gerunds',
    label: tSync('ui.category.gerunds', locale),
    match: (slug) => slug === 'top-1000-gerunds',
  },
];

interface LessonItem {
  id: number;
  slug: string;
  title: string;
  description: string;
  count: number;
  category: string;
}

const lessonsByCategory: Record<string, LessonItem[]> = {};
for (const c of categories) lessonsByCategory[c.key] = [];
const orphans: LessonItem[] = [];
for (const l of lessons) {
  // Vocabulary chunks live in /vocabulary, not here. Skip them so they
  // never appear as orphans at the bottom of the lessons list.
  if (l.slug.startsWith('vocab-chunk-')) continue;
  const cat = categories.find((c) => c.match(l.slug));
  if (cat) {
    lessonsByCategory[cat.key]!.push({ ...l, category: cat.key });
  } else {
    orphans.push({ ...l, category: 'other' });
  }
}
---
<Layout title={title} description={intro}>
  <section class="flex flex-col gap-8 py-6">
    <header>
      <h1 class="font-display text-3xl font-bold text-primary">{title}</h1>
      <p class="mt-1 text-slate-500 dark:text-slate-400">{intro}</p>
    </header>

    <a
      href="/vocabulary"
      class="lift-on-hover flex items-center justify-between gap-3 rounded-2xl border border-primary-200 bg-primary-50/60 px-5 py-4 transition hover:border-primary-300 hover:bg-primary-50 dark:border-primary-800 dark:bg-primary-800/20 dark:hover:bg-primary-800/30"
    >
      <div>
        <p class="text-xs font-bold uppercase tracking-wide text-primary-700 dark:text-primary-300">
          Top 2000 words
        </p>
        <p class="mt-0.5 text-sm text-slate-700 dark:text-slate-200">
          Vocabulary lives in its own section. 40 chunks of 50 words with quick quizzes.
        </p>
      </div>
      <span class="shrink-0 text-primary-700 dark:text-primary-300" aria-hidden="true">→</span>
    </a>

    {lessons.length === 0 ? (
      <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center dark:border-slate-700 dark:bg-slate-800">
        <p class="text-slate-500 dark:text-slate-400">No lessons published yet.</p>
      </div>
    ) : (
      <div class="flex flex-col gap-10">
        {categories.map((cat) => {
          const items = lessonsByCategory[cat.key] ?? [];
          if (items.length === 0) return null;
          return (
            <section
              id={`cat-${cat.key}`}
              class="flex flex-col gap-4 scroll-mt-20"
            >
              <div class="flex items-baseline justify-between gap-3 border-b border-slate-200 pb-2 dark:border-slate-700">
                <h2 class="font-display text-2xl font-semibold text-slate-900 dark:text-slate-100">
                  {cat.label}
                </h2>
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
                  {items.length} {items.length === 1 ? 'lesson' : 'lessons'}
                </span>
              </div>
              <ul class="grid gap-4 sm:grid-cols-2">
                {items.map((l) => (
                  <li>
                    <a
                      href={`/lessons/${l.slug}`}
                      class="lift-on-hover group flex h-full flex-col rounded-2xl border border-primary-100 bg-white p-6 shadow-sm transition hover:border-primary-300 hover:shadow-lg dark:border-primary-800 dark:bg-slate-800"
                    >
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wide text-primary-600 transition-colors group-hover:text-primary-700 dark:text-primary-400 dark:group-hover:text-primary-300">
                          {cat.label}
                        </span>
                        <span class="inline-flex items-center gap-1 rounded-full bg-primary-50 px-2.5 py-0.5 text-xs font-semibold text-primary-700 dark:bg-primary-800/30 dark:text-primary-200">
                          <span aria-hidden="true">✦</span>
                          {l.count} {l.count === 1 ? 'exercise' : 'exercises'}
                        </span>
                      </div>
                      <h3 class="mt-2 font-display text-lg font-semibold text-slate-900 transition-colors group-hover:text-primary-700 dark:text-slate-100 dark:group-hover:text-primary-300">
                        {l.title}
                      </h3>
                      <p class="mt-1 line-clamp-2 text-sm text-slate-500 dark:text-slate-400">
                        {l.description}
                      </p>
                      <LessonCardProgress
                        client:visible
                        lessonSlug={l.slug}
                        total={l.count}
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
      </div>
    )}

    <nav
      class="sticky bottom-0 -mx-6 mt-4 flex flex-wrap items-center gap-2 border-t border-slate-200 bg-white/95 px-6 py-3 backdrop-blur dark:border-slate-700 dark:bg-slate-900/90"
      aria-label="Lesson category shortcuts"
    >
      {categories.map((cat) => (
        <a
          href={`#cat-${cat.key}`}
          class="rounded-full border border-slate-300 bg-white px-3 py-1 text-xs font-medium text-slate-700 hover:border-primary-400 hover:bg-primary-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-primary-800/30"
        >
          {cat.label}
        </a>
      ))}
    </nav>
  </section>
</Layout>
