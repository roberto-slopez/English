---
import WebVitals from './WebVitals.astro';
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import LanguageSwitcher from './LanguageSwitcher.astro';
import NativeLanguageGate from './NativeLanguageGate.astro';
import ThemeToggle from './ThemeToggle.astro';
import { isSupportedLocale, DEFAULT_LOCALE, type Locale } from '../lib/i18n-locales.ts';
import { uiText } from '../lib/ui-labels.js';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'English Learning', description = 'Learn English with interactive lessons.' } = Astro.props as Props;

// Read ui locale from cookie, default to 'en'.
const cookieLocale = Astro.cookies.get('english.uiLocale')?.value;
const locale: Locale = (isSupportedLocale(cookieLocale) ? cookieLocale : DEFAULT_LOCALE) as Locale;
---
<!doctype html>
<html lang={locale} class="min-h-screen">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {/* Resolve explicit/system theme before paint. The small preferences module
        keeps these classes and color-scheme in sync after the page loads. */}
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('english.theme');
        } catch (e) { /* localStorage may be blocked */ }
        if (!theme) theme = document.cookie.split('; ').find(function (entry) { return entry.startsWith('english.theme='); })?.split('=')[1];
        var dark = theme === 'dark' || (theme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.add(dark ? 'dark' : 'light');
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        document.querySelector('meta[name="theme-color"]').content = dark ? '#0b0f19' : '#f8fafc';
      })();
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased dark:bg-slate-900 dark:text-slate-100">
    <a href="#main-content" class="skip-link">{uiText(locale, 'skipContent')}</a>
    <header class="app-header">
      <a href="/" class="touch-target font-display text-lg font-semibold text-link" translate="no">English</a>
      <nav class="flex flex-wrap items-center gap-2 text-base font-medium text-slate-700 dark:text-slate-200" aria-label={uiText(locale, 'navigation')}>
        <a href="/lessons" class="touch-target rounded-xl px-2 underline decoration-2 decoration-primary/60 underline-offset-4 hover:bg-primary-50 dark:hover:bg-primary-950" aria-current={Astro.url.pathname.startsWith('/lessons') ? 'page' : undefined}>{uiText(locale, 'lessons')}</a>
        <a href="/vocabulary" class="touch-target rounded-xl px-2 underline decoration-2 decoration-primary/60 underline-offset-4 hover:bg-primary-50 dark:hover:bg-primary-950" aria-current={Astro.url.pathname.startsWith('/vocabulary') ? 'page' : undefined}>{uiText(locale, 'vocabulary')}</a>
      </nav>
      <div class="header-preferences">
        <ThemeToggle uiLocale={locale} />
        <LanguageSwitcher initialLocale={locale} />
        <button type="button" data-preferences-open class="touch-target shrink-0 rounded-xl border border-slate-300 bg-white px-3 text-slate-700 hover:bg-primary-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-primary-950" aria-label={uiText(locale, 'preferences')} title={uiText(locale, 'preferences')}>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m12 3 2 3 3-1 1 3 3 1-1 3 1 3-3 1-1 3-3-1-2 3-2-3-3 1-1-3-3-1 1-3-1-3 3-1 1-3 3 1z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
    </header>
    <NativeLanguageGate uiLocale={locale} />
    <main id="main-content" tabindex="-1" class="mx-auto max-w-3xl px-4 py-6 sm:px-6 sm:py-10">
      <slot />
    </main>
    <script>
      import '../scripts/preferences.ts';
    </script>
  <WebVitals />
  </body>
</html>
