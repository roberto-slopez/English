---
import { uiText } from '../lib/ui-labels.js';
interface Props { uiLocale: string; }
const { uiLocale } = Astro.props;
---
<label class="preference-select" title={uiText(uiLocale, 'theme')}>
  <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
  <span class="sr-only">{uiText(uiLocale, 'theme')}</span>
  <select data-theme-select aria-label={uiText(uiLocale, 'theme')}>
    <option value="system">{uiText(uiLocale, 'system')}</option>
    <option value="light">{uiText(uiLocale, 'light')}</option>
    <option value="dark">{uiText(uiLocale, 'dark')}</option>
  </select>
</label>
