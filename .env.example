# Postgres connection string. On Railway, link the SSR service to the
# Postgres plugin and the env var is set automatically. Locally, point
# at a local Postgres instance or paste the Railway public URL.
#
# Format: postgres://user:password@host:port/dbname
# Example: postgres://postgres:dev@localhost:5432/english
DATABASE_URL=postgres://user:password@host:port/dbname
