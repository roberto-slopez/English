# Anything that's not needed inside the image. The build context can be
# large (node_modules, dist, .astro cache) and shipping them into the
# builder would slow the build and waste cache space.

# Build / dependency artifacts
node_modules
dist
.astro
.next
.turbo

# Local data directory (no longer used — the DB is network-attached)
data/

# Editor / OS noise
.DS_Store
.vscode
.idea
Thumbs.db

# Logs and coverage
*.log
coverage
.nyc_output

# Test / scratch
script-test.txt

# Local env files — DATABASE_URL is set by the Railway Postgres plugin
# on the linked service, never baked into the image.
.env
.env.*
