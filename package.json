{
  "name": "english",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate:translations && astro build",
    "preview": "astro preview",
    "db:seed": "pnpm validate:translations && tsx --env-file=.env src/lib/seed.ts",
    "db:reset": "pnpm validate:translations && tsx --env-file=.env src/lib/seed.ts reset",
    "validate": "tsx --env-file=.env scripts/validate-exercises.ts",
    "validate:translations": "tsx scripts/validate-translations.ts",
    "test:translations": "node --import tsx --test scripts/translations.test.ts",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/node": "latest",
    "@astrojs/react": "latest",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^6.4.8",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.43.0",
    "lucide-react": "latest",
    "marked": "^14.1.4",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@types/canvas-confetti": "^1.9.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
